# ─────────────────────────────────────────────────────────────────────────────
# Oak Capital — frontend environment
#
# Copy to `.env` for local development. On Vercel, set the same key under
# Project → Settings → Environment Variables (do NOT commit a real .env).
# Vite only exposes variables prefixed with VITE_ to the browser, so never put
# a secret here — everything below ships to the client.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Go backend's v1 API, including the /api/v1 suffix.
#
# Local dev (leave unset to use the Vite proxy in vite.config.ts):
#   VITE_API_BASE_URL=http://localhost:8080/api/v1
#
# Production — MUST be https, otherwise the browser blocks the requests as
# mixed content when the page itself is served over https from Vercel.
# The WebSocket URL is derived from this automatically (https → wss).
VITE_API_BASE_URL=https://your-backend-host.example.com/api/v1
