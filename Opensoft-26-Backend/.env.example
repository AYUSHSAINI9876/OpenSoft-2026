# Oak Capital Backend — environment variables
# Copy this file to .env and fill in your values.
# The server runs without a database; auth/portfolio persistence requires Postgres.

# ─── Database (optional — server starts without it) ──────────────────────────
# Full connection string takes precedence over individual vars.
DB_URL=postgres://user:password@localhost:5432/synthbull

# Individual vars (used if DB_URL is not set):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=synthbull

# ─── Redis (event bus — pub/sub + durable streams) ───────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Deployment mode ─────────────────────────────────────────────────────────
# Set to "production" when deploying. This makes insecure defaults fatal at
# boot (short/placeholder JWT_SECRET) instead of only logging a warning.
# APP_ENV=production

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters in production; the server refuses to
# start with a shorter or placeholder value when APP_ENV=production.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=synthbull_change_me_in_production_32chars

# ─── CORS ────────────────────────────────────────────────────────────────────
# localhost (any port) is ALWAYS allowed, so local dev needs nothing here.
# Deployed frontends must be listed explicitly as a comma-separated list of
# full origins — no trailing slash, no path:
#
#   CORS_ALLOWED_ORIGINS=https://oak-capital.vercel.app,https://app.example.com
#
# A leading "*." wildcard covers Vercel's per-deployment preview URLs:
#
#   CORS_ALLOWED_ORIGINS=https://oak-capital.vercel.app,https://*.vercel.app
#
# A single "*" allows every origin. Browsers reject credentialed requests
# against a wildcard, so use it only for a public read-only deployment.
# CORS_ALLOWED_ORIGINS=

# ─── SMTP (optional — required for forgot-password / delete-account emails) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=smtp_password

# ─── WebSocket URL for simulation bots ────────────────────────────────────────
# WS_URL=ws://localhost:8080/ws
